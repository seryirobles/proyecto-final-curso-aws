{
  "permissions": {
    "allow": [
      "Bash(./init.sh)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv add*)"
    ],
    "deny": [
      "Bash(terraform*)",
      "Bash(aws*)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
